{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "0.1.0",
  "description": "__MSG_extensionDescription__",
  "default_locale": "zh_CN",
  "chrome_url_overrides": {
    "newtab": "newtab/newtab.html"
  },
  "icons": {
    "16": "newtab/assets/icons/icon16.png",
    "32": "newtab/assets/icons/icon32.png",
    "48": "newtab/assets/icons/icon48.png",
    "128": "newtab/assets/icons/icon128.png"
  },
  "permissions": ["storage", "favicon", "cookies"],
  "host_permissions": [
    "https://*.kdocs.cn/*",
    "https://*.wps.cn/*",
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://ipapi.co/*",
    "https://ipwho.is/*"
  ]
}
